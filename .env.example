APP_NAME=FastWeb
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080

# Base de datos. Por defecto SQLite (funciona sin instalar nada).
DB_ENABLED=true
DB_CONNECTION=sqlite
# DB_DATABASE=storage/database.sqlite

# MySQL: descomentar y cambiar DB_CONNECTION=mysql
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=fastweb
# DB_USER=root
# DB_PASS=

JWT_SECRET=change_me
JWT_EXPIRATION=3600

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="FastWeb"
