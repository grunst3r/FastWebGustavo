{
    "name": "luigu/fastwebgustavo",
    "type": "project",
    "description": "Starter minimalista tipo Laravel con autenticacion incluida.",
    "keywords": ["starter", "php", "router", "mvc", "authentication", "blade"],
    "license": "MIT",
    "authors": [
        {
            "name": "Luis Gustavo",
            "email": "luigustavo@hotmail.es"
        }
    ],
    "require": {
        "php": ">=8.0",
        "eftec/bladeone": "^4.9",
        "illuminate/database": "8.72",
        "vlucas/phpdotenv": "^5.6",
        "symfony/http-foundation": "^7.3",
        "firebase/php-jwt": "^6.11",
        "phpmailer/phpmailer": "^6.10",
        "luigu/router-gust": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "ignore": [
                "PKSA-y2cr-5h3j-g3ys"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
